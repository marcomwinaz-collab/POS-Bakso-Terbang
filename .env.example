# Lokasi database SQLite lokal (atau URL Turso: libsql://nama-db.turso.io)
DATABASE_URL="file:./data/pos.db"
# Hanya untuk Turso
DATABASE_AUTH_TOKEN=""
# Ganti dengan string acak panjang (min. 32 karakter)
AUTH_SECRET="ganti-dengan-string-acak-yang-panjang-sekali-123456"
# Selisih zona waktu untuk laporan (WIB = 7, WITA = 8, WIT = 9)
TZ_OFFSET_HOURS=7
